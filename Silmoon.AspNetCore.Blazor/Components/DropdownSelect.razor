@typeparam TValue

@inject NavigationManager Navigation

<details class="dropdown-select @Class" data-dropdown-select data-align-end="@AlignEnd.ToString().ToLowerInvariant()" data-open-upward="@OpenUpward.ToString().ToLowerInvariant()" data-disabled="@Disabled.ToString().ToLowerInvariant()" data-enhance-nav="@EnhanceNavigation.ToString().ToLowerInvariant()" data-js-managed="@(JavaScriptManaged ? "true" : null)" data-value="@(JavaScriptManaged ? Value?.ToString() : null)" data-placeholder="@(JavaScriptManaged ? Placeholder : null)" @attributes="AdditionalAttributes">
    <summary id="@TriggerId" class="dropdown-select-trigger" aria-label="@($"{Label}: {SelectedOption?.Text ?? Placeholder}")" aria-disabled="@Disabled.ToString().ToLowerInvariant()" tabindex="@(Disabled ? -1 : 0)">
        @if (!string.IsNullOrEmpty(IconClass))
        {
            <i class="@IconClass" aria-hidden="true"></i>
        }
        <span data-dropdown-caption lang="@SelectedOption?.Language" dir="@SelectedOption?.Direction">@(SelectedOption?.Text ?? Placeholder)</span>
        <i class="bi bi-chevron-down dropdown-select-chevron" aria-hidden="true"></i>
    </summary>
    <div class="dropdown-select-options" popover="manual" role="group" aria-label="@Label">
        @foreach (var option in Items)
        {
            var selected = EqualityComparer<TValue>.Default.Equals(option.Value, Value);
            @if (!JavaScriptManaged && option.Href is not null && !option.Disabled && !Disabled)
            {
                <a class="dropdown-select-option @(selected ? "active" : null)" data-dropdown-option href="@option.Href" data-enhance-nav="@(EnhanceNavigation ? null : "false")" lang="@option.Language" dir="@option.Direction" aria-current="@(selected ? "true" : null)">
                    @OptionContent(option)
                </a>
            }
            else
            {
                <button class="dropdown-select-option @(selected ? "active" : null)" data-dropdown-option data-value="@(JavaScriptManaged ? option.Value?.ToString() ?? string.Empty : null)" data-option-disabled="@(JavaScriptManaged && option.Disabled ? "true" : null)" type="button" lang="@option.Language" dir="@option.Direction" aria-pressed="@selected.ToString().ToLowerInvariant()" disabled="@(Disabled || option.Disabled)" @onclick="OptionClick(option)">
                    @OptionContent(option)
                </button>
            }
        }
    </div>
</details>
<silmoon-blazor-module src="@Navigation.ToAbsoluteUri("_content/Silmoon.AspNetCore.Blazor/Components/DropdownSelect.razor.js?v=5")" hidden></silmoon-blazor-module>

@code {
    [Parameter] public IReadOnlyList<DropdownSelectOption<TValue>> Items { get; set; } = [];
    [Parameter] public TValue Value { get; set; } = default!;
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public string? IconClass { get; set; }
    [Parameter] public string? TriggerId { get; set; }
    [Parameter] public bool JavaScriptManaged { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool AlignEnd { get; set; }
    [Parameter] public bool OpenUpward { get; set; }
    [Parameter] public bool EnhanceNavigation { get; set; } = true;
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    DropdownSelectOption<TValue>? SelectedOption => Items.FirstOrDefault(option => EqualityComparer<TValue>.Default.Equals(option.Value, Value));

    RenderFragment<DropdownSelectOption<TValue>> OptionContent => option => @<text>
        @if (!string.IsNullOrWhiteSpace(option.IconClass))
        {
            <i class="@option.IconClass" aria-hidden="true"></i>
        }
        @if (!string.IsNullOrWhiteSpace(option.Description))
        {
            <span class="dropdown-select-copy">
                <span data-dropdown-text>@option.Text</span>
                <small>@option.Description</small>
            </span>
        }
        else
        {
            <span data-dropdown-text>@option.Text</span>
        }
        <i class="bi bi-check2 dropdown-select-check" aria-hidden="true"></i>
    </text>;

    EventCallback<MouseEventArgs> OptionClick(DropdownSelectOption<TValue> option) =>
        JavaScriptManaged
            ? default
            : EventCallback.Factory.Create<MouseEventArgs>(this, () => SelectOption(option));

    Task SelectOption(DropdownSelectOption<TValue> option) =>
        JavaScriptManaged || Disabled || option.Disabled || EqualityComparer<TValue>.Default.Equals(Value, option.Value)
            ? Task.CompletedTask
            : ValueChanged.InvokeAsync(option.Value);
}
